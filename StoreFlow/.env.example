# =====================================================================
# StoreFlow — environment variables
# =====================================================================
# ASP.NET Core reads configuration from appsettings.json by default, but in
# production you should override these values with real environment
# variables instead of committing secrets. ASP.NET Core maps a colon in a
# config key to a double underscore in an env var name, e.g. "Jwt:Key"
# becomes "Jwt__Key".
#
# Copy this file to `.env` for your own reference / for use with a process
# manager or Docker Compose. Plain ASP.NET Core does not auto-load `.env`
# files, so also export these (or set them in your hosting provider's
# dashboard) before running the API in production.

# --- Database ---
# For local/demo use, SQLite is fine (file-based, zero setup).
ConnectionStrings__DefaultConnection=Data Source=storeflow.db

# For production, point this at a real managed database instead of SQLite
# (see README "Production database" section), e.g.:
# ConnectionStrings__DefaultConnection=Host=your-db-host;Database=storeflow;Username=...;Password=...

# --- JWT authentication ---
Jwt__Key=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
Jwt__Issuer=StoreFlowApi
Jwt__Audience=StoreFlowClient
Jwt__ExpiryMinutes=480

# --- CORS ---
# Comma-separated in your own tooling if needed; appsettings.json stores
# this as a JSON array under Cors:AllowedOrigins. Add your deployed
# frontend's origin here once you know it, e.g. https://storeflow-frontend.onrender.com
Cors__AllowedOrigins__0=http://localhost:5500
Cors__AllowedOrigins__1=http://127.0.0.1:5500

# --- Frontend ---
# Set this in Frontend/js/config.js (or override window.STOREFLOW_API_BASE
# before it loads) to point the UI at your deployed backend, e.g.:
# https://storeflow-api.onrender.com/api
STOREFLOW_API_BASE=http://localhost:5080/api
